{
  "name": "base-ts-cli-lib-test",
  "version": "1.7.0",
  "author": "",
  "license": "ISC",
  "description": "",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "commit": "cz",
    "version": "bumpp -r",
    "build:lib": "npm run build --workspace @bt/lib",
    "prepare": "husky"
  },
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.8",
    "bumpp": "^10.1.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "packages/lib/src/**/*.ts": [
      "npm run build:lib",
      "git add packages/lib/js"
    ]
  }
}
